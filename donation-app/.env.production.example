# Production .env (Week 12 Day 4). Copy to .env on the server, fill in, then: php artisan config:cache
# Secrets (passwords, keys, salts) go ONLY into this file on the server or the Settings screens —
# never in chat, e-mail or git.

APP_NAME=Imdaad
APP_ENV=production
APP_DEBUG=false
APP_URL=https://imdaad.org.pk
APP_TIMEZONE=Asia/Karachi
APP_LOCALE=en
# Generate ONCE (php artisan key:generate), then copy it into the password manager + a sealed offline copy.
# Never change it: encrypted CNICs, accounts and 2FA secrets depend on it.
APP_KEY=

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=imdaad
DB_USERNAME=imdaad
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

SETTINGS_CACHE_ENABLED=true

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="donations@imdaad.org.pk"
MAIL_FROM_NAME="${APP_NAME}"

# First Super Admin (php artisan db:seed --class=SuperAdminSeeder). Remove the password afterwards.
ADMIN_NAME="Nadeem Ahmad"
ADMIN_EMAIL=
ADMIN_PASSWORD=

MFA_ENFORCE=true

# Alerts: backups, ledger check, ops:health. Heartbeat: healthchecks.io / Better Stack URL.
OPS_ALERT_EMAIL=
HEARTBEAT_URL=

# Backups: local + off-site (S3-compatible). Needs: composer require league/flysystem-aws-s3-v3
BACKUP_DISKS=local,backups
BACKUP_ARCHIVE_PASSWORD=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_PATH_STYLE=false
BACKUP_S3_ROOT=imdaad

# Receipt PDFs (headless Chrome via Puppeteer, installed by npm ci). Usually no change needed.
LARAVEL_PDF_NO_SANDBOX=true

# Never set in production (ignored anyway).
LOAD_TEST_IPS=
