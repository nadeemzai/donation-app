# =============================================================================
#  Donation Management System — environment template
#  Copy to .env and fill in. Never commit .env or real secrets.
#  Gateway and WhatsApp credentials are stored ENCRYPTED in Settings (admin);
#  values here are only first-run defaults.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="Donation Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://donation-app.test
APP_TIMEZONE=Asia/Karachi
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# --- Logging -----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (MySQL 8, utf8mb4) ---------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=donation_system
DB_USERNAME=root
DB_PASSWORD=

# --- Session / cache / queue -------------------------------------------------
# Local: database driver. Staging/production: redis (+ Horizon for queues).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
# CACHE_PREFIX=
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# --- Redis (staging/production) ----------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail (receipts, certificates) -------------------------------------------
# Local: log. Production: smtp or ses.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="donations@example.org"
MAIL_FROM_NAME="${APP_NAME}"

# --- File storage ------------------------------------------------------------
# Local: local. Staging/production: s3 (any S3-compatible provider).
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Seeded super admin (Week 1, Prompt 4) -----------------------------------
ADMIN_NAME="Super Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Two-factor login for Super Admin / Finance / Trustee. Can only be paused
# (false) when APP_ENV=local; always enforced on staging/production.
MFA_ENFORCE=true

# --- Payment gateways (Week 4) -----------------------------------------------
# Credentials are entered in Admin → Settings → Gateways (stored encrypted).
JAZZCASH_MODE=sandbox
EASYPAISA_MODE=sandbox
# Card PSP: Phase 2 — not used in the MVP.

# --- WhatsApp via Green API (Week 5) -----------------------------------------
# Values from console.green-api.com. Only opted-in donors are messaged.
GREEN_API_URL=https://api.green-api.com
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=
WHATSAPP_RATE_PER_MINUTE=20

# --- SMS (optional, OTP fallback only) ---------------------------------------
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=

# --- Frontend ----------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
